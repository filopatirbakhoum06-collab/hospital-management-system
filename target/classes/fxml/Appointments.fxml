<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospital.controller.AppointmentController" spacing="20" styleClass="root">
    
    <!-- Top Configuration Bar -->
    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="card">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
        
        <Label text="🔍" style="-fx-text-fill: -text-muted;"/>
        <TextField fx:id="searchField" promptText="Search Appointment ID, Doctor, or Patient..." styleClass="text-field" prefWidth="300"/>
        
        <Label text="Status:" style="-fx-text-fill: -text-muted;"/>
        <ComboBox fx:id="statusFilter" promptText="All Statuses" styleClass="combo-box" prefWidth="130"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <Button text="+  Create Available Slot" onAction="#handleAddSlot" styleClass="btn-primary"/>
    </HBox>

    <!-- Data Table Area -->
    <VBox VBox.vgrow="ALWAYS" styleClass="card">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
        
        <TableView fx:id="appointmentTable" VBox.vgrow="ALWAYS" styleClass="table-view" onMouseClicked="#handleTableClick">
            <columns>
                <TableColumn fx:id="colId" text="Appt ID" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="appointmentId"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colDate" text="Date" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="date"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colTime" text="Time Slot" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="timeSlot"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colDoctor" text="Doctor ID" prefWidth="120">
                    <cellValueFactory><PropertyValueFactory property="doctor"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colPatient" text="Patient ID" prefWidth="120">
                    <cellValueFactory><PropertyValueFactory property="patient"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="120" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Empty State UI -->
        <VBox fx:id="emptyState" alignment="CENTER" spacing="10" visible="false" managed="false">
            <padding><Insets top="50" bottom="50"/></padding>
            <Label text="📅" style="-fx-font-size: 60px;"/>
            <Label text="No appointments found." style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: -text-main;"/>
            <Label text="Try adjusting your filters or create a new slot." style="-fx-text-fill: -text-muted;"/>
        </VBox>
    </VBox>
</VBox>