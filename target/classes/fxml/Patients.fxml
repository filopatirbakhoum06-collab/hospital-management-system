<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospital.controller.PatientController" spacing="20" styleClass="root">
    
    <!-- Top Configuration Bar -->
    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="card">
        <padding><Insets top="15" right="20" bottom="15" left="20"/></padding>
        
        <Label text="🔍" style="-fx-text-fill: -text-muted;"/>
        <TextField fx:id="searchField" promptText="Search Name, ID, or Phone..." styleClass="text-field" prefWidth="250"/>
        
        <Label text="Blood Type:" style="-fx-text-fill: -text-muted;"/>
        <ComboBox fx:id="bloodTypeFilter" promptText="All Types" styleClass="combo-box" prefWidth="120"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <Button text="+  Register New Patient" onAction="#handleAddPatient" styleClass="btn-primary"/>
    </HBox>

    <!-- Data Table Area -->
    <VBox VBox.vgrow="ALWAYS" styleClass="card">
        <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
        
        <TableView fx:id="patientTable" VBox.vgrow="ALWAYS" styleClass="table-view" onMouseClicked="#handleTableClick">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="80">
                    <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colName" text="Full Name" prefWidth="200">
                    <cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colAge" text="Age" prefWidth="60">
                    <cellValueFactory><PropertyValueFactory property="age"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colBlood" text="Blood" prefWidth="80">
                    <cellValueFactory><PropertyValueFactory property="bloodType"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colPhone" text="Phone Number" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="phoneNumber"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colHistory" text="History ID" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="medicalHistoryId"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colAllergies" text="Allergies" prefWidth="150" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <!-- Empty State UI -->
        <VBox fx:id="emptyState" alignment="CENTER" spacing="10" visible="false" managed="false">
            <padding><Insets top="50" bottom="50"/></padding>
            <Label text="📂" style="-fx-font-size: 60px;"/>
            <Label text="No records found." style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: -text-main;"/>
            <Label text="Try adjusting your filters or add a new patient." style="-fx-text-fill: -text-muted;"/>
        </VBox>
    </VBox>
</VBox>